<Window x:Class="CMWTAT_DIGITAL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:CMWTAT_DIGITAL.Domain"
        xmlns:local="clr-namespace:CMWTAT_DIGITAL"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="{DynamicResource TitleName}" Height="600" Width="500"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Height="48"
        ui:TitleBar.MaximizeButtonAvailability="Collapsed"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        d:Background="Gray"
        d:DataContext="{d:DesignInstance domain:ViewModel, d:IsDesignTimeCreatable=False}"
        Icon="CMWTAT.ico"
        Closing="Window_Closing"
        Activated="Window_Activated"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        >
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="20,0,0,0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleBarIcon" Width="18" Height="18" VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="18,0,0,0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,0"
                           FontSize="11"/>
                        <TextBlock x:Name="titlebarVersion" Text="Preview"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,0"
                           FontSize="9"
                           Opacity="0.5" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="donateSwitchBtn" VerticalAlignment="Stretch" Padding="0" Width="32" Margin="4,8"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ui:FontIcon FontSize="14" Icon="{x:Static ui:SegoeFluentIcons.Heart}" />
                    </Button>
                    <Button x:Name="langSwitchBtn" VerticalAlignment="Stretch" Padding="0" Width="32" Margin="4,8"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ui:FontIcon FontSize="14" Icon="{x:Static ui:SegoeFluentIcons.LocaleLanguage}" />
                    </Button>
                    <Button x:Name="themeSwitchBtn" VerticalAlignment="Stretch" Padding="0" Width="32" Margin="4,8"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="themeSwitchBtn_Click">
                        <ui:FontIcon x:Name="themeSwitchIcon" FontSize="14" Icon="{x:Static ui:SegoeFluentIcons.System}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区域 -->
            <Border Grid.Row="1" ClipToBounds="True"
                CornerRadius="8, 8, 0, 0" Background="{DynamicResource LayerFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid VerticalAlignment="Stretch">
                    <Grid Margin="30,20,30,20" VerticalAlignment="Center">
                        <StackPanel>
                            <ui:SettingsCard Background="{DynamicResource LayerFillColorDefaultBrush}" ContentAlignment="Left" Padding="20" Margin="0,0,0,0">
                                <ui:SettingsCard.Content>
                                    <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" ><Run Text="{DynamicResource AppName}"/></TextBlock>
                                </ui:SettingsCard.Content>
                            </ui:SettingsCard>
                            <ui:SettingsCard Background="{DynamicResource LayerFillColorDefaultBrush}" ContentAlignment="Left" Padding="30,30" Margin="0,20,0,0">
                                <ui:SettingsCard.Content>
                                    <StackPanel>
                                        <Grid>
                                            <ComboBox x:Name="SystemEditionText" DisplayMemberPath="DisplayOS" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Visible"/>
                                            <TextBox x:Name="SystemEditionTextInput" ui:ControlHelper.PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" MaxLength="29" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" input:InputMethod.IsInputMethodEnabled="False" VerticalAlignment="Center" Visibility="Hidden" TextChanged="SystemEditionTextInput_TextChanged">
                                                <TextBox.Text>
                                                    <Binding Path="SN" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <domain:IsSN ValidatesOnTargetUpdated="True"/>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </Grid>
                                        <Grid Margin="0,30,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="AutoRadio" Grid.Column="0" Content="{DynamicResource Auto_Mode}" IsChecked="True" Checked="A_RadioButton_Checked"/>
                                            <RadioButton x:Name="ManualRadio" Grid.Column="2" Content="{DynamicResource Manual_Mode}" Checked="M_RadioButton_Checked"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:SettingsCard.Content>
                            </ui:SettingsCard>
                            <Button x:Name="actbtn" Click="Activate_Button_Click" Content="{DynamicResource Activate_Button}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"  ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65" />
                            <Button x:Name="installbtn" Click="installbtn_Click" Content="{DynamicResource Convert_versions}" HorizontalAlignment="Stretch" ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65"/>
                            <Button x:Name="upgradefullbtn" Click="upgradefullbtn_Click" Content="{DynamicResource Upgrade_full_version}" HorizontalAlignment="Stretch" ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65"/>
                        </StackPanel>
                    </Grid>
                    <!-- 对话框：使用框架自带的 ContentDialog，同一时间只能显示一个 -->
                    <ui:ContentDialog x:Name="DialogWait" d:Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:ProgressRing Grid.Row="1" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="48" Height="48" />
                            <TextBlock Grid.Row="3" Style="{DynamicResource BodyTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Loading}" />
                        </Grid>
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogActProg" d:Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:ProgressRing Grid.Row="1" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="48" Height="48" />
                            <TextBlock Grid.Row="3" Style="{DynamicResource BodyTextBlockStyle}" x:Name="activatingtext" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Activating}" />
                        </Grid>
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogWithCancel"
                        d:Visibility="Collapsed"
                        CloseButtonText="{DynamicResource Cancel}">
                        <StackPanel>
                            <ui:ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" />
                            <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Loading}" />
                        </StackPanel>
                    </ui:ContentDialog>
                    <!-- 以下这些对话框的正文长度不可控（错误代码 -4 会带上 slmgr 的原始输出，
                         各语言的长文本也可能撑高），所以放开正文的纵向滚动。
                         ContentDialog 的模板里本来就有一个 ContentScrollViewer 包着正文，
                         它的滚动条策略是 {TemplateBinding ScrollViewer.VerticalScrollBarVisibility}，
                         而默认样式把这个附加属性设成了 Disabled（正文超出直接裁掉），
                         所以这里显式改成 Auto 即可，不需要再自己套一层 ScrollViewer。
                         横向仍保持默认的 Disabled，否则 TextBlock 拿到无限宽度就不会自动换行了。
                         注意：进度类对话框（DialogWait / DialogActProg / DialogWithCancel）不能加，
                         它们内部用 Height="*" 的行做居中留白，一旦可滚动就会被压成 0 高。 -->
                    <ui:ContentDialog x:Name="DialogWithOK" Title="Title"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="Hello World" />
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogHelp" Title="Help"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource HelpText}"/>
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogWithExit" Title="{DynamicResource ErrorTitle}"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CloseButtonText="{DynamicResource Exit}" DefaultButton="Close" CloseButtonClick="Exit_Button_Click">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource Disconnect_to_server_exit}"/>
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogWithOKToCloseDialog" Title="Title"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogWithOKToCloseDialogText" TextWrapping="Wrap">Text</TextBlock>
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogWithOKToCloseDialogDonate" Title="{DynamicResource Complete}"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        PrimaryButtonText="{DynamicResource DonateBtn}" PrimaryButtonClick="Donate_Button_Click"
                        CloseButtonText="{DynamicResource Refuse}" DefaultButton="Primary">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogWithOKToCloseDialogDonateText" TextWrapping="Wrap" Text="{DynamicResource DonateTextActivated}" />
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogUpdate" Title="{DynamicResource UpdateTitle}"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        PrimaryButtonText="{DynamicResource UpdateNow}" PrimaryButtonClick="UpdateBtn_Click"
                        SecondaryButtonText="{DynamicResource Ignore}" DefaultButton="Primary">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogUpdateText" TextWrapping="Wrap" Text="{DynamicResource UpdateText}" />
                    </ui:ContentDialog>
                    <ui:ContentDialog x:Name="DialogUpgradeFullVersion" Title="{DynamicResource UpgradeFullVersionWindowsTitle}"
                        d:Visibility="Collapsed"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        PrimaryButtonText="{DynamicResource OK}" PrimaryButtonClick="UpgradeFullVersionWindows_Click"
                        CloseButtonText="{DynamicResource Cancel}" DefaultButton="Primary">
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource UpgradeFullVersionWindowsText}" />
                    </ui:ContentDialog>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
