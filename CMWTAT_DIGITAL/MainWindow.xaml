<Window x:Class="CMWTAT_DIGITAL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:CMWTAT_DIGITAL.Domain"
        xmlns:local="clr-namespace:CMWTAT_DIGITAL"
        mc:Ignorable="d"
        Title="{DynamicResource TitleName}" Height="600" Width="480"
        ResizeMode="NoResize"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        d:DataContext="{d:DesignInstance domain:ViewModel, d:IsDesignTimeCreatable=False}"
        Icon="CMWTAT.ico"
        Closing="Window_Closing"
        FontFamily="{DynamicResource Font}"
        Activated="Window_Activated"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        >
    <Grid>
        <Grid Margin="30,20,30,20" VerticalAlignment="Center">
            <StackPanel>
                <ui:SettingsCard ContentAlignment="Left" Padding="20" Margin="0,0,0,0">
                    <ui:SettingsCard.Content>
                        <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource SubtitleTextBlockStyle}" ><Run Text="{DynamicResource AppName}"/></TextBlock>
                    </ui:SettingsCard.Content>
                </ui:SettingsCard>
                <ui:SettingsCard ContentAlignment="Left" Padding="30,30" Margin="0,20,0,0">
                    <ui:SettingsCard.Content>
                        <StackPanel>
                            <Grid>
                                <ComboBox x:Name="SystemEditionText" DisplayMemberPath="DisplayOS" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Visible"/>
                                <TextBox x:Name="SystemEditionTextInput" ui:ControlHelper.PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" MaxLength="29" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" input:InputMethod.IsInputMethodEnabled="False" VerticalAlignment="Center" Visibility="Hidden" TextChanged="SystemEditionTextInput_TextChanged">
                                    <TextBox.Text>
                                        <Binding Path="SN" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <domain:IsSN ValidatesOnTargetUpdated="True"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                            <Grid Margin="0,30,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="AutoRadio" Grid.Column="0" Content="{DynamicResource Auto_Mode}" IsChecked="True" Checked="A_RadioButton_Checked"/>
                                <RadioButton x:Name="ManualRadio" Grid.Column="2" Content="{DynamicResource Manual_Mode}" Checked="M_RadioButton_Checked"/>
                            </Grid>
                        </StackPanel>
                    </ui:SettingsCard.Content>
                </ui:SettingsCard>
                <Button FontFamily="{DynamicResource Font}" x:Name="actbtn" Click="Activate_Button_Click" Content="{DynamicResource Activate_Button}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"  ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65" />
                <Button FontFamily="{DynamicResource Font}" x:Name="installbtn" Click="installbtn_Click" Content="{DynamicResource Convert_versions}" HorizontalAlignment="Stretch" ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65"/>
                <Button FontFamily="{DynamicResource Font}" x:Name="upgradefullbtn" Click="upgradefullbtn_Click" Content="{DynamicResource Upgrade_full_version}" HorizontalAlignment="Stretch" ui:ControlHelper.CornerRadius="8" Margin="0,20,0,0" Height="65"/>
            </StackPanel>
        </Grid>

        <!-- 对话框：使用框架自带的 ContentDialog，同一时间只能显示一个 -->
        <ui:ContentDialog x:Name="DialogWait">
            <StackPanel>
                <ui:ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" />
                <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Loading}" />
            </StackPanel>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogActProg">
            <StackPanel>
                <ui:ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" />
                <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" x:Name="activatingtext" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Activating}" />
            </StackPanel>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogWithCancel"
                          CloseButtonText="{DynamicResource Cancel}">
            <StackPanel>
                <ui:ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" />
                <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Loading}" />
            </StackPanel>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogWithOK" Title="Title"
                          CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="Hello World" />
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogHelp" Title="Help"
                          CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource HelpText}"/>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogWithExit" Title="{DynamicResource ErrorTitle}"
                          CloseButtonText="{DynamicResource Exit}" DefaultButton="Close" CloseButtonClick="Exit_Button_Click">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource Disconnect_to_server_exit}"/>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogWithOKToCloseDialog" Title="Title"
                          CloseButtonText="{DynamicResource OK}" DefaultButton="Close">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogWithOKToCloseDialogText" TextWrapping="Wrap">Text</TextBlock>
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogWithOKToCloseDialogDonate" Title="{DynamicResource Complete}"
                          PrimaryButtonText="{DynamicResource DonateBtn}" PrimaryButtonClick="Donate_Button_Click"
                          CloseButtonText="{DynamicResource Refuse}" DefaultButton="Primary">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogWithOKToCloseDialogDonateText" TextWrapping="Wrap" Text="{DynamicResource DonateTextActivated}" />
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogUpdate" Title="{DynamicResource UpdateTitle}"
                          PrimaryButtonText="{DynamicResource UpdateNow}" PrimaryButtonClick="UpdateBtn_Click"
                          SecondaryButtonText="{DynamicResource Ignore}" DefaultButton="Primary">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" x:Name="DialogUpdateText" TextWrapping="Wrap" Text="{DynamicResource UpdateText}" />
        </ui:ContentDialog>
        <ui:ContentDialog x:Name="DialogUpgradeFullVersion" Title="{DynamicResource UpgradeFullVersionWindowsTitle}"
                          PrimaryButtonText="{DynamicResource OK}" PrimaryButtonClick="UpgradeFullVersionWindows_Click"
                          CloseButtonText="{DynamicResource Cancel}" DefaultButton="Primary">
            <TextBlock FontFamily="{DynamicResource Font}" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="{DynamicResource UpgradeFullVersionWindowsText}" />
        </ui:ContentDialog>
    </Grid>

</Window>
